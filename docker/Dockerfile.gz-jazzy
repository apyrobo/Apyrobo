# syntax=docker/dockerfile:1.6
# =============================================================================
# APYROBO — Gazebo Harmonic integration image (ROS 2 Jazzy + Gazebo Harmonic +
# TurtleBot3 + apyrobo)
#
# The Jazzy counterpart of Dockerfile.gazebo (Humble + Gazebo Classic), built
# beside it as the first step of the port in docs/gz_sim_port.md. Boots a
# physics-simulated TurtleBot3 with tests/integration/gz_boot.sh. Not wired
# into Compose or CI yet.
#
# Build:
#   docker build -f docker/Dockerfile.gz-jazzy -t apyrobo-gz-jazzy:latest .
# Run the sim and the Gazebo adapter tests in one container:
#   docker run --rm apyrobo-gz-jazzy:latest bash -c \
#     'tests/integration/gz_boot.sh > /tmp/boot.log 2>&1 &
#      until timeout 5 ros2 topic echo /odom --once >/dev/null 2>&1; do sleep 2; done
#      APYROBO_GAZEBO=1 pytest -p no:launch_testing -m integration \
#        tests/integration/test_gazebo_turtlebot.py'
# =============================================================================

FROM ros:jazzy-ros-base

# ros-gz brings Gazebo Harmonic, ros_gz_sim and ros_gz_bridge; the Jazzy
# turtlebot3-gazebo models carry the gz DiffDrive plugin (/cmd_vel, /odom).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-rclpy \
    ros-jazzy-nav2-msgs \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf-transformations \
    ros-jazzy-ros-gz \
    ros-jazzy-turtlebot3-gazebo \
    ros-jazzy-turtlebot3-description \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml .
COPY apyrobo/ ./apyrobo/

# Real rclpy first on PYTHONPATH. Ubuntu 24.04 marks the system Python as
# externally managed; inside this single-purpose image installing over it is
# what we want. Debian's own pytest/pluggy carry no pip RECORD, so the test
# tools are installed beside them (--ignore-installed).
ENV PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir --ignore-installed pytest pytest-asyncio pytest-cov pytest-timeout websockets

# Drop the launch_testing pytest11 entry points if ros-jazzy-* installed any;
# on Humble they fail plugin validation on modern pytest at collection time.
RUN python3 - <<'PYEOF'
import os

roots = [
    "/opt/ros/jazzy/lib/python3.12/site-packages",
    "/usr/lib/python3/dist-packages",
    "/usr/local/lib/python3.12/dist-packages",
]
for root in roots:
    for dirpath, _dirnames, filenames in os.walk(root):
        if "entry_points.txt" not in filenames:
            continue
        path = os.path.join(dirpath, "entry_points.txt")
        with open(path) as fh:
            lines = fh.readlines()
        kept = [ln for ln in lines if not ("launch_testing" in ln and ":" not in ln)]
        if kept != lines:
            with open(path, "w") as fh:
                fh.writelines(kept)
            print("stripped launch_testing pytest11 entries from", path)
PYEOF

COPY tests/ ./tests/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DOMAIN_ID=42 \
    TURTLEBOT3_MODEL=burger

ENTRYPOINT ["/ros_entrypoint.sh"]

# Build-time gate: the ros2 adapter must actually register on Jazzy.
RUN timeout 60 /ros_entrypoint.sh python3 -c "\
from apyrobo.core import ros2_bridge; \
import sys; \
err = getattr(ros2_bridge, '_ROS2_IMPORT_ERROR', None); \
ok = ros2_bridge._HAS_ROS2; \
print('_HAS_ROS2 =', ok, '| import error:', err); \
sys.exit(0 if ok else 1)"

CMD ["bash", "tests/integration/gz_boot.sh"]
