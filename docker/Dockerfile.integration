# =============================================================================
# APYROBO — Integration test image (ROS 2 Humble + apyrobo + test deps)
#
# Used by the 'integration' Docker Compose profile to run tests/integration/.
#
# Build:
#   docker build -f docker/Dockerfile.integration -t apyrobo-integration:latest .
# =============================================================================

FROM ros:humble-ros-base

# Install ROS 2 message packages needed by the adapter and fake robot.
# ros-humble-rclpy is installed explicitly so its submodules (callback_group,
# executors, etc.) are guaranteed to be present via apt and not shadowed by
# any PyPI stub that pip --upgrade might introduce.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rclpy \
    ros-humble-nav2-msgs \
    ros-humble-tf2 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy apyrobo source and install it (includes rclpy bridge deps)
COPY pyproject.toml .
COPY apyrobo/ ./apyrobo/

# Ensure the ROS 2 Python packages are on PYTHONPATH at build time AND at
# runtime, regardless of whether the entrypoint has sourced setup.bash yet.
# /opt/ros/humble/lib/python3.10/site-packages contains the real rclpy;
# placing it first ensures it takes precedence over any pip-installed packages.
ENV PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages

# Install apyrobo + test dependencies.
# pip upgrade is required: the system pip in ros:humble-ros-base (pip 22)
# cannot install editable packages from pyproject.toml without setup.py
# (PEP 660 / build_editable hook). ros-humble-rclpy is already apt-pinned
# above so upgrading pip here cannot shadow it with a PyPI stub.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[dev]" 2>/dev/null || \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir pytest pytest-asyncio pytest-timeout

# Copy integration test files
COPY tests/ ./tests/

# Source ROS 2 environment for every command via ros_entrypoint.sh
# The base image already provides /ros_entrypoint.sh
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DOMAIN_ID=42

ENTRYPOINT ["/ros_entrypoint.sh"]
# Run only the integration-marked tests. Do NOT pass tests/integration/ as an
# explicit path: pytest 9 with testpaths=["tests"] in pyproject.toml still scans
# the full testpaths tree and triggers module-level pytest.skip() in the mocked
# test files, which produces "0 items / 1 skipped" + "no collectors" when an
# explicit subdirectory path is also given. Relying solely on -m integration
# lets pytest collect from testpaths naturally and filter by marker.
#
# -p no:launch_testing: ros-humble-* apt packages pull in the `launch_testing`
# pytest11 plugin, which auto-registers globally and is unrelated to this
# suite. Its pytest_pycollect_makemodule hookimpl targets an older pytest
# hookspec, so newer pytest (installed unpinned above) fails plugin
# validation at collection time before any test runs. We never use
# launch_testing here, so disable it explicitly instead of pinning pytest.
CMD ["pytest", "-p", "no:launch_testing", "-m", "integration", "-v", "--tb=short"]
