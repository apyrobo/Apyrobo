# syntax=docker/dockerfile:1.6
# =============================================================================
# APYROBO — Integration test image (ROS 2 Humble + apyrobo + test deps)
#
# Used by the 'integration' Docker Compose profile to run tests/integration/.
#
# Build:
#   docker build -f docker/Dockerfile.integration -t apyrobo-integration:latest .
# =============================================================================

FROM ros:humble-ros-base

# Install ROS 2 message packages needed by the adapter and fake robot.
# ros-humble-rclpy is installed explicitly so its submodules (callback_group,
# executors, etc.) are guaranteed to be present via apt and not shadowed by
# any PyPI stub that pip --upgrade might introduce.
# ros-humble-tf-transformations provides the tf_transformations module
# imported by apyrobo.core.ros2_bridge (ros-humble-tf2 does NOT include it);
# without it the bridge's import guard silently sets _HAS_ROS2=False and the
# ros2:// adapter never registers.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rclpy \
    ros-humble-nav2-msgs \
    ros-humble-tf2 \
    ros-humble-tf-transformations \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy apyrobo source and install it (includes rclpy bridge deps)
COPY pyproject.toml .
COPY apyrobo/ ./apyrobo/

# Ensure the ROS 2 Python packages are on PYTHONPATH at build time AND at
# runtime, regardless of whether the entrypoint has sourced setup.bash yet.
# /opt/ros/humble/lib/python3.10/site-packages contains the real rclpy;
# placing it first ensures it takes precedence over any pip-installed packages.
ENV PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages

# Install apyrobo + test dependencies.
# pip upgrade is required: the system pip in ros:humble-ros-base (pip 22)
# cannot install editable packages from pyproject.toml without setup.py
# (PEP 660 / build_editable hook). ros-humble-rclpy is already apt-pinned
# above so upgrading pip here cannot shadow it with a PyPI stub.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[dev]" 2>/dev/null || \
    pip install --no-cache-dir -e . && \
    pip install --no-cache-dir pytest pytest-asyncio pytest-timeout

# ros-humble-* apt packages (transitively) install multiple pytest11 plugins
# whose module paths reference `launch_testing` (observed so far: the
# `launch_testing` and `launch_testing_ros` distributions), which
# auto-register globally even though tests/integration/ never uses them.
# Their hookimpls target hooks pytest doesn't know (either an outdated
# hookspec or a custom hook pytest never had), so pytest raises
# PluginValidationError while loading setuptools entry points or while
# validating pending hooks at collection time, before any real test runs.
# `-p no:launch_testing` does not prevent this in practice (the plugin still
# gets loaded ahead of the exclusion pass), so instead strip only the
# pytest11-style entry_points.txt lines that reference launch_testing: a
# bare `name = module.path` with no `:callable` suffix. This deliberately
# excludes console_scripts-style entries like
# `launch_test = launch_testing.launch_test:main` (has a colon), which are
# unrelated CLI tools we must not touch. Fails loudly if nothing matches or
# a removal doesn't stick, so a wrong assumption surfaces as a clear build
# error instead of the same mystery crash two steps later.
#
# Scan only the Python package roots, with os.walk (never follows symlinks).
# A previous version globbed /**/entry_points.txt from /: recursive glob
# follows symlinks, so /proc/self/root -> / made it recurse forever and
# hang the build.
RUN python3 - <<'PYEOF'
import os, sys

def is_target(line: str) -> bool:
    return "launch_testing" in line and ":" not in line

roots = [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/usr/lib/python3/dist-packages",
    "/usr/local/lib/python3.10/dist-packages",
]

paths = []
for root in roots:
    for dirpath, _dirnames, filenames in os.walk(root):
        if "entry_points.txt" in filenames:
            paths.append(os.path.join(dirpath, "entry_points.txt"))

changed = []
for path in paths:
    try:
        with open(path) as fh:
            lines = fh.readlines()
    except OSError:
        continue
    kept, removed = [], []
    for line in lines:
        (removed if is_target(line) else kept).append(line)
    if removed:
        with open(path, "w") as fh:
            fh.writelines(kept)
        changed.append(path)
        for line in removed:
            print(f"removed from {path}: {line.strip()}")

if not changed:
    print("ERROR: no entry_points.txt with a launch_testing pytest11 entry found", file=sys.stderr)
    sys.exit(1)

remaining = [p for p in paths if any(is_target(l) for l in open(p, errors="ignore"))]
if remaining:
    print(f"ERROR: launch_testing pytest11 entry still present in: {remaining}", file=sys.stderr)
    sys.exit(1)

print("OK — stripped launch_testing pytest11 entries from:", changed)
PYEOF

# Copy integration test files
COPY tests/ ./tests/

# Source ROS 2 environment for every command via ros_entrypoint.sh
# The base image already provides /ros_entrypoint.sh
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROS_DOMAIN_ID=42

ENTRYPOINT ["/ros_entrypoint.sh"]

# TEMP DIAGNOSTIC — apyrobo/__init__.py swallows the real ros2_bridge import
# error behind a bare `except Exception: pass` and reports a generic "rclpy
# not available" RuntimeError at test time. A plain `RUN python3 -c
# "from apyrobo.core import ros2_bridge"` earlier in this file (before ENV/
# ENTRYPOINT were set) succeeded cleanly, yet the actual test run still hits
# the stub adapter's RuntimeError. This runs the same check *through*
# /ros_entrypoint.sh, after ENV PYTHONPATH/ROS_DOMAIN_ID are set, matching
# actual container-start conditions (source setup.bash may reorder
# PYTHONPATH) to see whether that's what's different.
RUN timeout 30 /ros_entrypoint.sh python3 -c "\
import sys; \
print('PYTHONPATH=', sys.path); \
from apyrobo.core import ros2_bridge; \
print('_HAS_ROS2=', ros2_bridge._HAS_ROS2); \
import apyrobo; \
from apyrobo.core.adapters import _ADAPTER_REGISTRY; \
print('ros2 in registry:', 'ros2' in _ADAPTER_REGISTRY); \
print('registered class:', _ADAPTER_REGISTRY.get('ros2')); \
" 2>&1; \
    status=$?; \
    if [ "$status" -eq 124 ]; then \
        echo "DIAGNOSTIC: entrypoint-wrapped import timed out after 30s"; \
    else \
        echo "DIAGNOSTIC: entrypoint-wrapped import exited with status $status"; \
    fi

# Run only the integration-marked tests. Do NOT pass tests/integration/ as an
# explicit path: pytest 9 with testpaths=["tests"] in pyproject.toml still scans
# the full testpaths tree and triggers module-level pytest.skip() in the mocked
# test files, which produces "0 items / 1 skipped" + "no collectors" when an
# explicit subdirectory path is also given. Relying solely on -m integration
# lets pytest collect from testpaths naturally and filter by marker.
#
# -p no:launch_testing: ros-humble-* apt packages pull in the `launch_testing`
# pytest11 plugin, which auto-registers globally and is unrelated to this
# suite. Its pytest_pycollect_makemodule hookimpl targets an older pytest
# hookspec, so newer pytest (installed unpinned above) fails plugin
# validation at collection time before any test runs. We never use
# launch_testing here, so disable it explicitly instead of pinning pytest.
CMD ["pytest", "-p", "no:launch_testing", "-m", "integration", "-v", "--tb=short"]
