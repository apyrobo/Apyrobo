# =============================================================================
# APYROBO Skill Registry — minimal single-service image
#
# Build:  docker build -f docker/Dockerfile.registry -t apyrobo-registry:latest .
# Run:    docker run -p 8080:8080 apyrobo-registry:latest
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

# Install apyrobo with registry extras
COPY pyproject.toml .
COPY apyrobo/ ./apyrobo/

RUN pip install --no-cache-dir ".[registry]"

# Runtime configuration
ENV REGISTRY_DB_PATH=/data/registry.db
ENV APYROBO_REGISTRY_TOKEN=""
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

CMD ["python", "-m", "apyrobo.cli", "registry", "start", "--port", "8080"]
